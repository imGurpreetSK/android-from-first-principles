---
// This component is a Go deeper box. The HTML <details> element is collapsible, keyboard accessible and works without JavaScript.
// Without the open attribute, the box is closed. Starlight gives <details> its style in chapter content.
interface Props {
  title: string;
}

const { title } = Astro.props;
// MDX does not check props, so a box without a title fails the build here.
if (!title) throw new Error('<GoDeeper> needs a title.');
---

<details>
  <summary>Go deeper: {title}</summary>
  <slot />
</details>
