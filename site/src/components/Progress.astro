---
import { getChapters } from '../chapters';

const chapters = await getChapters();
// The id of a chapter is <section-slug>/<chapter-slug> (src/sections.ts).
const slugOf = (id: string) => id.split('/')[1];

// The page shows the tracker only after the script reads the storage. Without JavaScript or storage, the tracker stays hidden.
// data-pagefind-ignore keeps the tracker out of the search index.
---

<p class="progress" data-slug={slugOf(Astro.locals.starlightRoute.entry.id)} data-slugs={chapters.map(({ id }) => slugOf(id)).join(' ')} data-pagefind-ignore hidden>
  <button type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓ </span>Mark as read</button>
  <span class="count">0</span> / {chapters.length} chapters read
</p>

<script>
  import { progress, show, toggle } from '../progress';

  const tracker = document.querySelector<HTMLElement>('.progress')!;
  const button = tracker.querySelector('button')!;
  const count = tracker.querySelector('.count')!;
  const slugs = tracker.dataset.slugs!.split(' ');
  const slug = tracker.dataset.slug!;
  const storage = () => localStorage;
  const ui = { tracker, button, count };

  show(progress(storage, slugs, slug), ui);
  button.addEventListener('click', () => show(toggle(storage, slugs, slug), ui));
  // If the browser restores the page from the back/forward cache, the script does not run again. Thus the listener reads the storage again.
  addEventListener('pageshow', (e) => e.persisted && show(progress(storage, slugs, slug), ui));
</script>

<style>
  button {
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 999rem;
    padding: 0.4375rem 1.125rem;
    margin-inline-end: 1rem;
    background: none;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  /* A read chapter gets the colors of the primary Starlight link button. */
  button[aria-pressed='true'] {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }
  /* A check mark shows a read chapter, so the state does not depend only on the colors. aria-hidden keeps the check mark out of the name of the button. */
  button[aria-pressed='false'] .check {
    display: none;
  }
</style>
