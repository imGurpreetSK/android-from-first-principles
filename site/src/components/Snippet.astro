---
// Shows one region of a samples/ file in a code block, for example:
// <Snippet file="main-thread/src/main/kotlin/NaiveLooper.kt" region="loop" />
import { extname } from 'node:path';
import { Code } from '@astrojs/starlight/components';
import { root } from 'astro:config/server';
import { snippet } from '../snippet';

interface Props {
  // The path of the file under samples/.
  file: string;
  region: string;
}

const { file, region } = Astro.props;
// samples/ is next to the Astro root. In the repo, the Astro root is site/.
const code = snippet(new URL('../samples/', root), file, region);
---

<Code code={code} lang={extname(file).slice(1)} />
